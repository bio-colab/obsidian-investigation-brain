{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/benchmark-v1/ground_truth.schema.json",
  "title": "Investigation Benchmark Ground Truth",
  "type": "object",
  "required": ["case_id", "truth_status", "evidence", "hypotheses"],
  "additionalProperties": true,
  "properties": {
    "case_id": { "type": "string" },
    "truth_status": {
      "type": "string",
      "enum": ["established", "probable", "disputed", "unknown", "cold", "false_trap"]
    },
    "canonical_conclusion": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "source_kind": {
            "type": "string",
            "enum": ["operational", "public-archive", "archival", "official-archive", "declassified", "technical"]
          },
          "required": { "type": "boolean", "default": true },
          "must_have_coc": { "type": "boolean" },
          "must_have_provenance": { "type": "boolean" },
          "summary": { "type": "string" }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "kind"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["primary", "alternative", "counter", "rejected"]
          },
          "required": { "type": "boolean", "default": true },
          "expected_support_level": {
            "type": "string",
            "enum": ["weak", "moderate", "strong", "conclusive", "cause-unknown"]
          },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "counter_of": { "type": "string" },
          "expected_counter_themes": { "type": "array", "items": { "type": "string" } },
          "is_trap": { "type": "boolean", "default": false }
        }
      }
    },
    "timeline_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "timestamp", "summary"],
        "properties": {
          "id": { "type": "string" },
          "timestamp": { "type": "string" },
          "precision": {
            "type": "string",
            "enum": ["exact", "approximate", "day-only", "month-only", "year-only", "unknown"]
          },
          "summary": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "participants": { "type": "array", "items": { "type": "string" } },
          "location": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "related_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "phase_id": { "type": "string" }
        }
      }
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "match_patterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "forbidden_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "group_entity_only": {
      "type": "boolean",
      "description": "If true, inventing individual victim/passenger names is a false inference"
    },
    "report_must_cite": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string" },
          "must_link_evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "role": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "readiness_expectations": {
      "type": "object",
      "properties": {
        "allow_final_report": { "type": "boolean" },
        "min_verified_evidence": { "type": "integer" },
        "require_counters": { "type": "boolean" }
      }
    }
  }
}
