{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/benchmark-v1/evaluation_result.schema.json",
  "title": "Investigation Benchmark Evaluation Result",
  "type": "object",
  "required": ["benchmark_version", "case_id", "metrics", "case_score"],
  "properties": {
    "benchmark_version": { "type": "string" },
    "case_id": { "type": "string" },
    "run_id": { "type": "string" },
    "vault_path": { "type": "string" },
    "scored_at": { "type": "string" },
    "case_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "hard_fails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "msg": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "score"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "number" },
          "raw": {},
          "details": {}
        }
      }
    },
    "skill_audit": {},
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
