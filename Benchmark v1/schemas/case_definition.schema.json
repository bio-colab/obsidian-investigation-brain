{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/benchmark-v1/case_definition.schema.json",
  "title": "Investigation Benchmark Case Definition",
  "type": "object",
  "required": ["case_id", "title", "difficulty", "case_status", "scope", "phases"],
  "additionalProperties": true,
  "properties": {
    "case_id": { "type": "string", "pattern": "^CASE-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "version": { "type": "string" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "case_status": {
      "type": "string",
      "enum": ["active", "open-investigation", "cold-case", "closed", "training"]
    },
    "domain_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "homicide", "organized-crime", "financial", "cyber", "aviation",
          "maritime", "industrial", "cold-case", "archival", "corruption",
          "missing-person", "terrorism-historical", "regulatory", "fictional",
          "serial-offender"
        ]
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public-historical", "fictional", "desensitized-composite"]
    },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "team_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "source_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["operational", "public-archive", "mixed", "technical"]
      }
    },
    "expected_modes": {
      "type": "array",
      "items": { "type": "string", "enum": ["A", "B", "C", "D"] }
    },
    "notes": { "type": "string" }
  }
}
